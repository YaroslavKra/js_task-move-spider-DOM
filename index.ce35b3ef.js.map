var wall = document.querySelector(".wall");
var spider = document.querySelector(".spider");
wall.addEventListener("click", function(e) {
    var wallRect = wall.getBoundingClientRect();
    var spiderWidth = spider.offsetWidth;
    var spiderHeight = spider.offsetHeight;
    var x = e.clientX - wallRect.left - wall.clientLeft - spiderWidth / 2;
    var y = e.clientY - wallRect.top - wall.clientTop - spiderHeight / 2;
    if (x < 0) x = 0;
    if (y < 0) y = 0;
    if (x + spiderWidth > wall.clientWidth) x = wall.clientWidth - spiderWidth;
    if (y + spiderHeight > wall.clientHeight) y = wall.clientHeight - spiderHeight;
    spider.style.left = "".concat(x, "px");
    spider.style.top = "".concat(y, "px");
});

